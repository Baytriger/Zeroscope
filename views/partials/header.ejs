<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'ZEROSCOPE' %></title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Professional Fonts: Outfit (headings) + Inter (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: ['attribute', '[data-theme="dark"]'],
      theme: {
        extend: {
          fontFamily: {
            heading: ['Outfit', 'sans-serif'],
            body: ['Inter', 'sans-serif'],
          },
          colors: {
            cyan: { 400: '#22d3ee', 500: '#06b6d4' },
          }
        }
      }
    }
  </script>

  <style>
    /* ── CSS Custom Properties ───────────────────────────────────────────── */
    :root {
      --bg:           #0a0f1e;
      --bg-card:      #0f1629;
      --bg-card2:     #141d35;
      --border:       rgba(34, 211, 238, 0.15);
      --border-hover: rgba(34, 211, 238, 0.4);
      --text:         #e2e8f0;
      --text-muted:   #94a3b8;
      --text-dim:     #64748b;
      --accent:       #22d3ee;
      --accent-rgb:   34,211,238;
      --accent-glow:  rgba(34, 211, 238, 0.25);
      --accent2:      #0ea5e9;
      --hot:          #f59e0b;
      --success:      #10b981;
      --danger:       #ef4444;
      --warning:      #f59e0b;
      --purple:       #8b5cf6;
    }
    [data-theme="light"] {
      --bg:           #f0f4ff;
      --bg-card:      #ffffff;
      --bg-card2:     #f8faff;
      --border:       rgba(6, 182, 212, 0.2);
      --border-hover: rgba(6, 182, 212, 0.5);
      --text:         #0f172a;
      --text-muted:   #475569;
      --text-dim:     #94a3b8;
      --accent:       #0891b2;
      --accent-rgb:   8,145,178;
      --accent-glow:  rgba(8, 145, 178, 0.15);
      --accent2:      #0369a1;
      --hot:          #d97706;
      --success:      #059669;
      --danger:       #dc2626;
      --warning:      #d97706;
      --purple:       #7c3aed;
    }

    /* ── Base ────────────────────────────────────────────────────────────── */
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body { overflow-x: hidden; }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
      transition: background 0.3s, color 0.3s;
    }
    h1,h2,h3,h4,h5,h6 { font-family: 'Outfit', sans-serif; }

    /* ── Background Pattern ──────────────────────────────────────────────── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 20% -10%, rgba(34,211,238,0.08) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 110%, rgba(139,92,246,0.06) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }
    [data-theme="light"] body::before {
      background:
        radial-gradient(ellipse 80% 50% at 20% -10%, rgba(8,145,178,0.06) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 110%, rgba(124,58,237,0.04) 0%, transparent 60%);
    }

    /* ── Cards ───────────────────────────────────────────────────────────── */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px var(--accent-glow);
    }

    /* ── Navbar ──────────────────────────────────────────────────────────── */
    .navbar {
      background: rgba(10, 15, 30, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    [data-theme="light"] .navbar {
      background: rgba(240, 244, 255, 0.9);
    }

    /* ── Buttons ─────────────────────────────────────────────────────────── */
    .btn-accent {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      padding: 10px 20px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.15s;
      font-size: 0.9rem;
    }
    .btn-accent:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-outline {
      background: transparent;
      border: 1px solid var(--border-hover);
      color: var(--accent);
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      border-radius: 10px;
      padding: 10px 20px;
      cursor: pointer;
      transition: background 0.2s;
      font-size: 0.9rem;
    }
    .btn-outline:hover { background: var(--accent-glow); }

    /* ── Badges / Pills ──────────────────────────────────────────────────── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 10px;
      border-radius: 99px;
      font-size: 0.72rem;
      font-weight: 600;
      font-family: 'Outfit', sans-serif;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
    .badge-bounty  { background: rgba(34,211,238,0.12); color: #22d3ee; border: 1px solid rgba(34,211,238,0.3); }
    .badge-grant   { background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }
    .badge-job     { background: rgba(139,92,246,0.12); color: #8b5cf6; border: 1px solid rgba(139,92,246,0.3); }
    .badge-event   { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); }
    .badge-hot     { background: rgba(239,68,68,0.12);  color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }

    /* ── Category Filter Tabs ────────────────────────────────────────────── */
    .filter-tab {
      padding: 8px 18px;
      border-radius: 10px;
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      border: 1px solid var(--border);
      color: var(--text-muted);
      background: transparent;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .filter-tab:hover, .filter-tab.active {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-glow);
    }

    /* ── Stat Cards ──────────────────────────────────────────────────────── */
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 24px;
      transition: border-color 0.2s;
    }
    .stat-card:hover { border-color: var(--border-hover); }
    .stat-value {
      font-family: 'Outfit', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
      line-height: 1;
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 500;
      margin-top: 4px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* ── Countdown ───────────────────────────────────────────────────────── */
    .countdown { font-family: 'Outfit', sans-serif; font-size: 0.8rem; font-weight: 700; }
    .countdown.urgent { color: var(--danger); animation: pulse 1.5s infinite; }
    .countdown.warning { color: var(--warning); }
    .countdown.ok { color: var(--success); }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.6} }

    /* ── Hot glow ────────────────────────────────────────────────────────── */
    .hot-badge {
      animation: hotpulse 2s infinite;
    }
    @keyframes hotpulse { 0%,100%{box-shadow:0 0 0 rgba(239,68,68,0)} 50%{box-shadow:0 0 12px rgba(239,68,68,0.5)} }

    /* ── Notification Panel ──────────────────────────────────────────────── */
    .notif-panel {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      width: 360px;
      max-width: calc(100vw - 32px);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      z-index: 200;
      overflow: hidden;
    }

    /* ── AI Chat ─────────────────────────────────────────────────────────── */
    .chat-bubble-user { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border-radius: 16px 16px 4px 16px; }
    .chat-bubble-ai   { background: var(--bg-card2); border: 1px solid var(--border); border-radius: 16px 16px 16px 4px; }

    /* ── Input ───────────────────────────────────────────────────────────── */
    .zs-input {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      padding: 10px 14px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      width: 100%;
      outline: none;
      transition: border-color 0.2s;
    }
    .zs-input:focus { border-color: var(--accent); }
    .zs-input::placeholder { color: var(--text-dim); }

    /* ── Select ──────────────────────────────────────────────────────────── */
    .zs-select {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      padding: 10px 14px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      outline: none;
      cursor: pointer;
    }
    .zs-select:focus { border-color: var(--accent); }

    /* ── Scrollbar ───────────────────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 3px; }


    
    
    

    /* ── Mobile responsive helpers ───────────────────────────────────────── */
    @media (max-width: 640px) {
      .stat-value { font-size: 1.4rem; }
      .stat-card  { padding: 10px 12px; overflow: hidden; }
      .notif-panel { width: calc(100vw - 24px); right: -60px; }

      /* Cards full width on mobile */
      .card { border-radius: 14px; }

      /* Filter tabs scrollable */
      .filter-tab { font-size: 0.78rem; padding: 7px 14px; }

      /* Badge font size */
      .badge { font-size: 0.65rem; }



      /* Chat bubble width on mobile */
      .chat-bubble-user, .chat-bubble-ai { max-width: 90% !important; }

      /* Footer text wrap */
      footer .flex { flex-direction: column; text-align: center; gap: 8px; }

      /* Auth pages */
      .auth-card { padding: 24px 20px !important; }

      /* Inputs full width */
      .zs-input, .zs-select { font-size: 16px !important; width: 100%; box-sizing: border-box; } /* prevents iOS zoom */
    }

    @media (max-width: 400px) {
      .stat-value { font-size: 1.2rem; }
      h1 { font-size: 1.6rem !important; }
    }

    /* ── Fade in animation ───────────────────────────────────────────────── */
    .fade-in { animation: fadeIn 0.4s ease both; }
    @keyframes fadeIn { from { opacity:0; transform: translateY(8px); } to { opacity:1; transform: none; } }
  </style>
</head>
<body>

<!-- ═══ NAVBAR ═══════════════════════════════════════════════════════════════ -->
<nav class="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0">
        <img src="/logo.jpg" alt="ZEROSCOPE" class="h-9 w-9 rounded-lg object-cover" />
        <span style="font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:800;color:var(--accent);letter-spacing:-0.02em;">
          ZEROSCOPE
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/" class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors <%= currentPath === '/' ? 'text-[var(--accent)]' : 'text-[var(--text-muted)] hover:text-[var(--text)]' %>" style="font-family:'Outfit',sans-serif;">Opportunities</a>
        <a href="/bookmarks" class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors <%= currentPath === '/bookmarks' ? 'text-[var(--accent)]' : 'text-[var(--text-muted)] hover:text-[var(--text)]' %>" style="font-family:'Outfit',sans-serif;">Bookmarks</a>
        <a href="/profile" class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors <%= currentPath === '/profile' ? 'text-[var(--accent)]' : 'text-[var(--text-muted)] hover:text-[var(--text)]' %>" style="font-family:'Outfit',sans-serif;">Profile</a>
      </div>

      <!-- Right actions -->
      <div class="flex items-center gap-2 sm:gap-3">

        <!-- X (Twitter) Social -->
        <a href="https://x.com/ZeroScopeHQ" target="_blank" rel="noopener noreferrer" class="hidden sm:flex w-9 h-9 rounded-lg items-center justify-center transition-colors hover:bg-[var(--accent-glow)]" style="border:1px solid var(--border);color:var(--text-muted);" title="Follow @ZeroScopeHQ on X" aria-label="X / Twitter">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.763l7.659-8.741L1.928 2.25h6.927l4.346 5.739zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>

        <!-- Theme Toggle -->
        <button onclick="toggleTheme()" class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors hover:bg-[var(--accent-glow)]" style="border:1px solid var(--border);color:var(--text-muted);" title="Toggle theme" aria-label="Toggle theme">
          <span id="themeIcon">◐</span>
        </button>

        <!-- Notifications -->
        <div class="relative" id="notifWrapper">
          <button onclick="toggleNotifications()" class="w-9 h-9 rounded-lg flex items-center justify-center relative transition-colors hover:bg-[var(--accent-glow)]" style="border:1px solid var(--border);color:var(--text-muted);" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full text-white text-xs flex items-center justify-center font-bold" style="background:var(--danger);font-family:'Outfit',sans-serif;font-size:0.6rem;">
              <%= unreadCount > 9 ? '9+' : unreadCount %>
            </span>
            <% } %>
          </button>

          <!-- Notification Panel -->
          <div id="notifPanel" class="notif-panel hidden">
            <div class="flex items-center justify-between px-4 py-3" style="border-bottom:1px solid var(--border);">
              <span style="font-family:'Outfit',sans-serif;font-weight:700;color:var(--text);">Notifications</span>
              <button onclick="markAllRead()" class="text-xs font-semibold" style="color:var(--accent);font-family:'Outfit',sans-serif;">Mark all read</button>
            </div>
            <div class="overflow-y-auto" style="max-height:360px;">
              <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
                <% notifications.slice(0,10).forEach(function(n) { %>
                <div class="flex gap-3 px-4 py-3 cursor-pointer transition-colors hover:bg-[var(--bg-card2)] <%= !n.read ? 'border-l-2' : '' %>" style="<%= !n.read ? 'border-left-color:var(--accent)' : '' %>;border-bottom:1px solid var(--border);" onclick="readNotif('<%= n._id %>')">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-base" style="background:var(--bg-card2);">
                    <%= n.type === 'deadline_critical' ? '!' : n.type === 'deadline_warning' ? '◆' : n.type === 'won' ? '+' : n.type === 'new_grant' ? '$' : n.type === 'new_job' ? '◎' : '★' %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:0.8rem;color:var(--text);" class="truncate"><%= n.title %></p>
                    <p style="font-size:0.75rem;color:var(--text-muted);" class="mt-0.5 line-clamp-2"><%= n.message %></p>
                    <p style="font-size:0.7rem;color:var(--text-dim);" class="mt-1"><%= new Date(n.createdAt).toLocaleDateString() %></p>
                  </div>
                </div>
                <% }) %>
              <% } else { %>
              <div class="px-4 py-10 text-center" style="color:var(--text-muted);">
                <div class="text-3xl mb-2">🔔</div>
                <p style="font-family:'Outfit',sans-serif;font-size:0.85rem;">No notifications yet</p>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Auth -->
        <% if (typeof userId !== 'undefined' && userId) { %>
        <div class="flex items-center gap-2">
          <span style="font-size:0.8rem;color:var(--text-muted);font-family:'Outfit',sans-serif;font-weight:600;" class="hidden sm:inline">👤 <%= username %></span>
          <form action="/auth/logout" method="POST" style="display:inline;">
            <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors" style="border:1px solid var(--border);color:var(--text-muted);background:transparent;font-family:'Outfit',sans-serif;cursor:pointer;" onmouseover="this.style.borderColor='var(--danger)';this.style.color='var(--danger)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
              Sign Out
            </button>
          </form>
        </div>
        <% } else { %>
        <div class="flex items-center gap-2">
          <a href="/auth/login" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors hidden sm:inline-block" style="border:1px solid var(--border);color:var(--text-muted);font-family:'Outfit',sans-serif;" onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">Sign In</a>
          <a href="/auth/register" class="btn-accent px-3 py-1.5 text-xs hidden sm:inline-block" style="border-radius:8px;">Register</a>
        </div>
        <% } %>

        <!-- Wallet connect removed -->

        <!-- Mobile menu toggle -->
        <button class="md:hidden w-9 h-9 rounded-lg flex items-center justify-center" style="border:1px solid var(--border);color:var(--text-muted);" onclick="toggleMobileMenu()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="md:hidden hidden pb-3 pt-1" style="border-top:1px solid var(--border);">
      <div class="flex flex-col gap-1 mt-2">
        <a href="/" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--text-muted);">🏠 Opportunities</a>
        <a href="/bookmarks" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--text-muted);">Bookmarks</a>
        <a href="/profile" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--text-muted);">👤 Profile</a>

        <a href="https://x.com/ZeroScopeHQ" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--text-muted);">🐦 Follow @ZeroScopeHQ</a>

        <div style="height:1px;background:var(--border);margin:6px 0;"></div>

        <% if (typeof userId !== 'undefined' && userId) { %>
        <div class="px-4 py-2 flex items-center justify-between">
          <span style="font-size:0.875rem;color:var(--text-muted);font-family:'Outfit',sans-serif;">👤 <%= username %></span>
          <form action="/auth/logout" method="POST">
            <button type="submit" style="font-size:0.8rem;color:#f87171;font-family:'Outfit',sans-serif;font-weight:600;background:none;border:none;cursor:pointer;">Sign Out</button>
          </form>
        </div>
        <% } else { %>
        <a href="/auth/login" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--text-muted);">🔑 Sign In</a>
        <a href="/auth/register" class="px-4 py-2.5 rounded-lg text-sm font-semibold" style="font-family:'Outfit',sans-serif;color:var(--accent);">✨ Create Account</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- Toast Container -->
<div id="toastContainer" class="fixed bottom-6 right-4 z-50 flex flex-col gap-2" style="max-width:min(320px,calc(100vw - 2rem));"></div>

