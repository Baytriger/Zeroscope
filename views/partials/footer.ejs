<script>
// ═══════════════════════════════════════════════════════════════════════════
// ZEROSCOPE — Client-side JS
// ═══════════════════════════════════════════════════════════════════════════

// ── Theme ──────────────────────────────────────────────────────────────────
(function() {
  var saved = localStorage.getItem('zs-theme') || 'light';
  document.documentElement.setAttribute('data-theme', saved);
  var icon = document.getElementById('themeIcon');
  if (icon) icon.textContent = saved === 'dark' ? 'Dark' : 'Light';
})();

function toggleTheme() {
  var current = document.documentElement.getAttribute('data-theme');
  var next = current === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('zs-theme', next);
  var icon = document.getElementById('themeIcon');
  if (icon) icon.textContent = next === 'dark' ? 'Dark' : 'Light';
}

// ── Mobile Menu ────────────────────────────────────────────────────────────
function toggleMobileMenu() {
  var menu = document.getElementById('mobileMenu');
  if (menu) menu.classList.toggle('hidden');
}

// ── Notifications ──────────────────────────────────────────────────────────
function toggleNotifications() {
  var panel = document.getElementById('notifPanel');
  if (panel) panel.classList.toggle('hidden');
}
document.addEventListener('click', function(e) {
  var wrapper = document.getElementById('notifWrapper');
  var panel   = document.getElementById('notifPanel');
  if (wrapper && panel && !wrapper.contains(e.target)) {
    panel.classList.add('hidden');
  }
});
function markAllRead() {
  fetch('/notifications/read-all', { method: 'POST' })
    .then(function() {
      showToast('All notifications marked as read', 'success');
      var panel = document.getElementById('notifPanel');
      if (panel) panel.classList.add('hidden');
      setTimeout(function() { location.reload(); }, 800);
    })
    .catch(function() { showToast('Could not mark as read', 'error'); });
}
function readNotif(id) {
  fetch('/notifications/' + id + '/read', { method: 'POST' }).catch(function() {});
}

// ── Toast ──────────────────────────────────────────────────────────────────
function showToast(message, type) {
  type = type || 'info';
  var colors = { success: '#10b981', error: '#ef4444', info: '#22d3ee', warning: '#f59e0b' };
  var container = document.getElementById('toastContainer');
  if (!container) return;
  var toast = document.createElement('div');
  toast.style.cssText = [
    'display:flex;align-items:center;gap:10px;',
    'padding:12px 16px;border-radius:12px;',
    'background:var(--bg-card);',
    'border:1px solid ' + (colors[type] || colors.info) + '60;',
    'color:var(--text);',
    'box-shadow:0 8px 24px rgba(0,0,0,0.25);',
    'font-family:Inter,sans-serif;font-size:0.875rem;',
    'max-width:320px;word-break:break-word;',
    'transition:opacity 0.5s;'
  ].join('');
  toast.innerHTML = '<span style="font-weight:700;color:' + (colors[type] || colors.info) + ';">' + type.charAt(0).toUpperCase() + type.slice(1) + '</span><span>' + message + '</span>';
  container.appendChild(toast);
  setTimeout(function() { toast.style.opacity = '0'; }, 3500);
  setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 4200);
}

// ── Bookmark ───────────────────────────────────────────────────────────────
async function saveBookmark(btn, data) {
  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = '...';
  try {
    var res = await fetch('/bookmarks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data),
    });
    var json = await res.json();
    if (json.requiresLogin) {
      showToast('Sign in to save bookmarks', 'warning');
      setTimeout(function() { window.location.href = '/auth/login'; }, 1200);
      btn.innerHTML = orig;
      btn.disabled = false;
      return;
    }
    if (json.success) {
      btn.innerHTML = 'Saved';
      btn.style.color = 'var(--accent)';
      btn.style.borderColor = 'var(--accent)';
      showToast('Saved to bookmarks!', 'success');
    } else if (json.alreadySaved) {
      btn.innerHTML = 'Saved';
      btn.style.color = 'var(--accent)';
      btn.style.borderColor = 'var(--accent)';
      showToast('Already bookmarked', 'info');
    } else {
      btn.innerHTML = orig;
      btn.disabled = false;
      showToast(json.message || 'Could not save', 'error');
    }
  } catch(err) {
    btn.innerHTML = orig;
    btn.disabled = false;
    showToast('Connection error — try again', 'error');
  }
}

// ── Countdown timers ───────────────────────────────────────────────────────
function updateCountdowns() {
  document.querySelectorAll('[data-deadline]').forEach(function(el) {
    var val = el.getAttribute('data-deadline');
    if (!val || val === 'null' || val === 'undefined' || val.trim() === '') {
      el.textContent = '';
      return;
    }
    var deadline = new Date(val);
    if (isNaN(deadline.getTime())) { el.textContent = ''; return; }
    var now  = new Date();
    var diff = deadline - now;
    if (diff <= 0) {
      el.textContent = 'Expired';
      el.className   = 'countdown urgent';
      return;
    }
    var days = Math.floor(diff / 86400000);
    var hrs  = Math.floor((diff % 86400000) / 3600000);
    var mins = Math.floor((diff % 3600000) / 60000);
    var text = days > 0 ? (days + 'd ' + hrs + 'h') : hrs > 0 ? (hrs + 'h ' + mins + 'm') : (mins + 'm');
    el.textContent = text + ' left';
    el.className   = 'countdown ' + (diff < 86400000 ? 'urgent' : diff < 259200000 ? 'warning' : 'ok');
  });
}
document.addEventListener('DOMContentLoaded', function() {
  updateCountdowns();
  setInterval(updateCountdowns, 60000);
});

// ── AI Chat ────────────────────────────────────────────────────────────────
var chatOpen = false;
var chatInited = false;

function toggleChat() {
  chatOpen = !chatOpen;
  var panel = document.getElementById('chatPanel');
  if (!panel) return;
  if (chatOpen) {
    panel.classList.remove('hidden');
    if (!chatInited) {
      chatInited = true;
      appendMessage('ai', "Hi, I'm ZERO. How can I help you today?");
    }
    var input = document.getElementById('chatInput');
    if (input) setTimeout(function() { input.focus(); }, 100);
  } else {
    panel.classList.add('hidden');
  }
}

function closeChatPanel() {
  chatOpen = false;
  var panel = document.getElementById('chatPanel');
  if (panel) panel.classList.add('hidden');
}

function appendMessage(role, text) {
  var box = document.getElementById('chatMessages');
  if (!box) return;
  var row = document.createElement('div');
  row.style.cssText = 'display:flex;' + (role === 'user' ? 'justify-content:flex-end;' : 'justify-content:flex-start;');
  var bubble = document.createElement('div');
  bubble.style.cssText = 'max-width:82%;padding:10px 14px;font-size:0.875rem;line-height:1.55;white-space:pre-wrap;word-break:break-word;font-family:Inter,sans-serif;' +
    (role === 'user'
      ? 'background:var(--accent);color:#fff;border-radius:16px 16px 4px 16px;'
      : 'background:var(--bg-card2);border:1px solid var(--border);border-radius:16px 16px 16px 4px;color:var(--text);');
  bubble.textContent = text;
  row.appendChild(bubble);
  box.appendChild(row);
  box.scrollTop = box.scrollHeight;
}

async function sendChatMessage() {
  var input = document.getElementById('chatInput');
  if (!input) return;
  var msg = input.value.trim();
  if (!msg) return;
  input.value = '';
  appendMessage('user', msg);

  var box = document.getElementById('chatMessages');
  var typing = document.createElement('div');
  typing.id = 'zsTyping';
  typing.style.cssText = 'display:flex;justify-content:flex-start;';
  typing.innerHTML = '<div style="padding:10px 14px;background:var(--bg-card2);border:1px solid var(--border);border-radius:16px 16px 16px 4px;color:var(--text-muted);font-size:0.8rem;font-family:Inter,sans-serif;">Thinking...</div>';
  if (box) { box.appendChild(typing); box.scrollTop = box.scrollHeight; }

  try {
    var res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg }),
    });
    var data = await res.json();
    var t = document.getElementById('zsTyping');
    if (t && t.parentNode) t.parentNode.removeChild(t);
    appendMessage('ai', data.reply || 'No response received.');
  } catch(err) {
    var t = document.getElementById('zsTyping');
    if (t && t.parentNode) t.parentNode.removeChild(t);
    appendMessage('ai', 'Connection issue. Please try again.');
  }
}

document.addEventListener('DOMContentLoaded', function() {
  var input = document.getElementById('chatInput');
  if (input) {
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChatMessage(); }
    });
  }
});
</script>

<!-- ═══ CHAT FAB + PANEL ════════════════════════════════════════════════ -->
<div style="position:fixed;bottom:24px;right:24px;z-index:300;">

  <!-- Chat Panel -->
  <div id="chatPanel" class="hidden" style="position:absolute;bottom:68px;right:0;width:min(360px,calc(100vw - 48px));background:var(--bg-card);border:1px solid var(--border);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.35);overflow:hidden;display:flex;flex-direction:column;">
    <div style="padding:14px 16px;border-bottom:1px solid var(--border);background:var(--bg-card2);display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:0.95rem;color:var(--text);">ZERO Assistant</div>
        <div style="font-size:0.7rem;color:var(--success);font-weight:600;letter-spacing:0.03em;">Online</div>
      </div>
      <button onclick="closeChatPanel()" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.4rem;line-height:1;padding:2px 6px;" title="Close">&times;</button>
    </div>
    <div id="chatMessages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;min-height:260px;max-height:360px;scroll-behavior:smooth;"></div>
    <div style="padding:12px;border-top:1px solid var(--border);display:flex;gap:8px;">
      <input id="chatInput" type="text" placeholder="Ask about opportunities..." autocomplete="off"
        style="flex:1;background:var(--bg-card2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:9px 12px;font-family:'Inter',sans-serif;font-size:0.875rem;outline:none;transition:border-color 0.2s;"
        onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
      <button onclick="sendChatMessage()"
        style="background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;border-radius:10px;padding:9px 16px;cursor:pointer;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.85rem;white-space:nowrap;transition:opacity 0.2s;"
        onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
        Send
      </button>
    </div>
  </div>

  <!-- FAB Button -->
  <button id="chatFab" onclick="toggleChat()"
    style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;cursor:pointer;box-shadow:0 4px 20px var(--accent-glow);font-family:'Outfit',sans-serif;font-weight:800;font-size:1.1rem;display:flex;align-items:center;justify-content:center;transition:transform 0.2s;"
    onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'"
    title="Chat with ZERO">Z</button>
</div>

<!-- ═══ FOOTER ══════════════════════════════════════════════════════════ -->
<footer style="border-top:1px solid var(--border);background:var(--bg-card);padding:24px 0;margin-top:48px;position:relative;z-index:1;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span style="font-family:'Outfit',sans-serif;font-weight:800;font-size:1rem;color:var(--accent);">ZEROSCOPE</span>
      <span style="color:var(--border-hover);">—</span>
      <span style="font-size:0.85rem;color:var(--text-muted);font-family:'Inter',sans-serif;">Built for the Zero Authority DAO Community</span>
    </div>
    <div style="font-size:0.8rem;color:var(--text-muted);font-family:'Outfit',sans-serif;font-weight:600;letter-spacing:0.03em;">
      by <span style="color:var(--accent);">ChainBuilders</span>
    </div>
  </div>
</footer>

</body>
